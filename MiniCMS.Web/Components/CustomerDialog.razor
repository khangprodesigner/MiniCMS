@using MiniCMS.Application.DTOs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)" Class="mr-2 mb-n1" />
            @(IsEdit ? "Cập nhật thông tin khách hàng" : "Thêm mới khách hàng")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="@Model">
            <MudGrid Spacing="2">
                @if (!IsEdit)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="Model.CustomerCode"
                                      Label="Mã khách hàng"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      RequiredError="Mã khách hàng không được để trống" />
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.FullName"
                                  Label="Họ và tên"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Họ và tên không được để trống" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Email không được để trống" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.PhoneNumber"
                                  Label="Số điện thoại"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="Số điện thoại không được để trống" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Ngày sinh"
                                   @bind-Date="dateOfBirth"
                                   DateFormat="dd/MM/yyyy"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   MaxDate="DateTime.Today" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center justify-start pt-3">
                    <MudSwitch T="bool" 
                               @bind-Value="Model.IsActive" 
                               Color="Color.Success" 
                               UncheckedColor="Color.Default"
                               Label="@(Model.IsActive ? "Trạng thái: Đang hoạt động" : "Trạng thái: Tạm khóa")" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy bỏ</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Lưu dữ liệu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public CreateCustomerDto Model { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; } = false;

    private MudForm form = default!;
    private DateTime? dateOfBirth;

    protected override void OnInitialized()
    {
        if (!IsEdit)
        {
            // Mặc định khách hàng mới sẽ được kích hoạt
            Model.IsActive = true;
        }
        if (Model.DateOfBirth != default)
        {
            dateOfBirth = Model.DateOfBirth.ToDateTime(TimeOnly.MinValue);
        }
        else
        {
            dateOfBirth = DateTime.Today.AddYears(-20);
        }
    }

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!form.IsValid) return;

        if (dateOfBirth.HasValue)
        {
            Model.DateOfBirth = DateOnly.FromDateTime(dateOfBirth.Value);
        }

        MudDialog.Close(DialogResult.Ok(Model));
    }

    private void Cancel() => MudDialog.Cancel();
}